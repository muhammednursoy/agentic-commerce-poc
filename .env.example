# LLM for the agent: gemini | claude | scripted (default: gemini if GEMINI_API_KEY is set, else claude if ANTHROPIC_API_KEY, else scripted)
LLM_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# ucp (Google UCP + Google Pay, default) | acp (ACP via Adyen Commerce Suite) | stripe (merchant-hosted ACP + Stripe Shared Payment Tokens)
PROTOCOL=ucp

# Stripe secret TEST key (sk_test_...): real Stripe test API. Unset: local mock Stripe. sk_live_ keys refuse to start.
# STRIPE_SECRET_KEY=
# STRIPE_API_BASE=
# Bearer key the agent sends on the merchant's /acp/checkout_sessions API (default mock_merchant_acp_key)
# MERCHANT_ACP_API_KEY=
# Shopper's Stripe test PaymentMethod used for the simulated SPT grant: pm_card_visa | pm_card_chargeDeclined | pm_card_authenticationRequired
# AGENT_STRIPE_PAYMENT_METHOD=pm_card_visa

# mock (default, local fake Adyen) | test (real Adyen test environment); any other value fails at startup
# test mode requires ADYEN_CHECKOUT_API_KEY and never uses mock credentials
ADYEN_MODE=mock
# Required for ADYEN_MODE=test, otherwise every webhook is rejected (ADYEN_WEBHOOK_INSECURE=1 accepts unsigned ones)
# ADYEN_HMAC_KEY=
# GOOGLE_PAY_MERCHANT_ID=
# Real Google Pay test token for ADYEN_MODE=test: raw JSON or @path/to/token.json
# GOOGLE_PAY_TOKEN=
# ADYEN_COMPANY_ACCOUNT=
# ADYEN_MERCHANT_ACCOUNT=
# ADYEN_COMMERCE_SUITE_API_KEY=
# ADYEN_AGENTIC_TOKEN=
# ADYEN_CHECKOUT_API_KEY=
# Bearer secret Adyen sends on the merchant's /agentic/* hooks
# MERCHANT_HOOK_SECRET=

# advanced: merchant calls /payments with the ACP token | standard: Adyen authorises
MERCHANT_FLOW=advanced
MERCHANT_URL=http://localhost:8081

# Shopper's vaulted test card (agent platform side). Ending in 0002 is refused by the mock.
AGENT_TEST_CARD=4111111111111111

# 0 disables HTTP tracing
TRACE=1
